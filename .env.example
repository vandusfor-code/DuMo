# ─────────────────────────────────────────────────────────────
# DuMo — Google Sheets service account credentials (SERVER ONLY)
# ─────────────────────────────────────────────────────────────
# Copy to `.env.local` for local dev, or set these in the Vercel
# project settings (Environment Variables) for production.
#
# If ANY of these is missing, the app automatically falls back to
# in-memory mock data — useful for local development without a sheet.

GOOGLE_PROJECT_ID=your-gcp-project-id
GOOGLE_CLIENT_EMAIL=service-account@your-project.iam.gserviceaccount.com

# Paste the full PEM. On Vercel, keep the literal "\n" sequences on one line
# (the app converts them back to real newlines). Wrapping quotes are stripped.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# The spreadsheet ID from its URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=your-spreadsheet-id

# IMPORTANT: share the spreadsheet with GOOGLE_CLIENT_EMAIL as Editor,
# otherwise the service account cannot read/write it.

# ─────────────────────────────────────────────────────────────
# WhatsApp — Coexistencia (Embedded Signup) — reutiliza la app de dulabs
# ─────────────────────────────────────────────────────────────
# Públicas (se exponen al cliente para el botón de login):
NEXT_PUBLIC_META_APP_ID=tu-meta-app-id            # el App ID de la app de dulabs
NEXT_PUBLIC_META_CONFIG_ID=tu-config-id           # el Config ID del Embedded Signup (coexistencia)
NEXT_PUBLIC_META_GRAPH_VERSION=v21.0
# featureType del Embedded Signup para coexistencia (debe coincidir con dulabs):
NEXT_PUBLIC_META_ES_FEATURE_TYPE=whatsapp_business_app_onboarding

# Privadas (SOLO servidor):
META_APP_ID=tu-meta-app-id
META_APP_SECRET=tu-meta-app-secret                # NUNCA se expone al cliente
META_GRAPH_VERSION=v21.0

# Webhook de WhatsApp:
WHATSAPP_VERIFY_TOKEN=una-cadena-secreta-que-tu-defines   # la pones igual en el panel de Meta
# Token permanente de System User para ENVIAR mensajes (número propio):
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v21.0
