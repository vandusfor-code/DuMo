# ─────────────────────────────────────────────────────────────
# DuMo — Google Sheets service account credentials (SERVER ONLY)
# ─────────────────────────────────────────────────────────────
# Copy to `.env.local` for local dev, or set these in the Vercel
# project settings (Environment Variables) for production.
#
# If ANY of these is missing, the app automatically falls back to
# in-memory mock data — useful for local development without a sheet.

GOOGLE_PROJECT_ID=your-gcp-project-id
GOOGLE_CLIENT_EMAIL=service-account@your-project.iam.gserviceaccount.com

# Paste the full PEM. On Vercel, keep the literal "\n" sequences on one line
# (the app converts them back to real newlines). Wrapping quotes are stripped.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# The spreadsheet ID from its URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=your-spreadsheet-id

# IMPORTANT: share the spreadsheet with GOOGLE_CLIENT_EMAIL as Editor,
# otherwise the service account cannot read/write it.
